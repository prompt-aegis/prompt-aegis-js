{
  "name": "prompt-aegis-js",
  "private": true,
  "description": "Framework-agnostic TypeScript monorepo for LLM security: prompt sanitization & agent-tarpit defense.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm build && pnpm test && pnpm -r publish --access public",
    "release:dry": "pnpm build && pnpm -r publish --dry-run --no-git-checks",
    "demo": "pnpm build && pnpm --filter @prompt-aegis/demo-site start",
    "attack": "pnpm build && pnpm --filter @prompt-aegis/demo-site attack",
    "attack:unprotected": "pnpm build && pnpm --filter @prompt-aegis/demo-site attack:unprotected",
    "trap-demo": "pnpm build && node examples/agent-trap/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
