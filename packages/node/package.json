{
  "name": "@prompt-aegis/node",
  "version": "0.1.1",
  "description": "Server-side adapters (Express, Koa, Fastify, Fetch/Hono) that sanitize LLM-bound input and serve tarpits to malicious AI scrapers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompt-aegis/prompt-aegis-js.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/prompt-aegis/prompt-aegis-js/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/prompt-aegis/prompt-aegis-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prompt-aegis/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
