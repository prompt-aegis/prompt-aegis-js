{
  "name": "@prompt-aegis/node",
  "version": "0.1.0",
  "description": "Server-side adapters (Express, Koa, Fastify, Fetch/Hono) that sanitize LLM-bound input and serve tarpits to malicious AI scrapers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prompt-aegis/core": "workspace:*"
  }
}
